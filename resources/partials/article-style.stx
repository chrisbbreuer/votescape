{{-- The look of a page of prose: the about page, and the pages like it. --}}
<style>
.va-page {
  min-height: 100vh;
  color: #e9edf5;
  background: radial-gradient(1200px 600px at 50% -10%, #17203a 0%, #0b0f17 60%);
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 16px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

.va-page *,
.va-page *::before,
.va-page *::after {
  box-sizing: border-box;
}

.va-page :focus-visible {
  outline: 2px solid #8ab4ff;
  outline-offset: 2px;
}

.va-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 860px;
  margin: 0 auto;
  padding: 16px 20px;
}

.va-brand {
  display: inline-flex;
  gap: 9px;
  align-items: center;
  color: #e9edf5;
  font-weight: 650;
  font-size: 18px;
  letter-spacing: -0.02em;
  text-decoration: none;
}

.va-back {
  padding: 7px 12px;
  color: #e9edf5;
  font-weight: 550;
  font-size: 13px;
  text-decoration: none;
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 10px;
}

.va-back:hover {
  border-color: rgba(148, 163, 184, 0.45);
}

.va-article {
  max-width: 860px;
  margin: 0 auto;
  padding: 48px 20px 96px;
}

.va-eyebrow {
  margin: 0;
  color: #9aa5b8;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.va-article h1 {
  max-width: 16ch;
  margin: 10px 0 0;
  font-weight: 700;
  font-size: clamp(34px, 6vw, 56px);
  line-height: 1.05;
  letter-spacing: -0.03em;
}

.va-lede {
  max-width: 60ch;
  margin: 20px 0 0;
  color: #c6cedb;
  font-size: clamp(17px, 2.2vw, 20px);
  line-height: 1.55;
}

.va-article section {
  margin-top: 48px;
}

.va-grid {
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  margin-top: 48px;
}

.va-grid section {
  margin-top: 0;
  padding: 22px;
  background: rgba(14, 19, 30, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16px;
}

.va-article h2 {
  margin: 0 0 10px;
  font-weight: 650;
  font-size: 20px;
  letter-spacing: -0.01em;
}

.va-article p {
  max-width: 68ch;
  margin: 0 0 12px;
  color: #c6cedb;
}

.va-article a {
  color: #8ab4ff;
  text-underline-offset: 3px;
}

.va-scale {
  height: 10px;
  margin: 16px 0 5px;
  background: linear-gradient(90deg, #a50f15 0%, #de2d26 25%, #fb9a8a 42%, #e8dce4 50%, #9ab8ef 58%, #3b82f6 75%, #1e40af 100%);
  border-radius: 999px;
}

.va-scale-ends {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14px;
  color: #9aa5b8;
  font-size: 12px;
}

.va-list {
  display: grid;
  gap: 0;
  margin: 0;
  border-top: 1px solid rgba(148, 163, 184, 0.18);
}

.va-list > div {
  display: grid;
  gap: 4px 24px;
  grid-template-columns: 150px 1fr;
  padding: 14px 0;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.va-list dt {
  font-weight: 650;
}

.va-list dd {
  margin: 0;
  color: #c6cedb;
}

.va-notes {
  display: grid;
  gap: 10px;
  max-width: 72ch;
  margin: 0;
  padding: 0;
  color: #c6cedb;
  list-style: none;
}

.va-notes li {
  padding-left: 16px;
  border-left: 2px solid rgba(148, 163, 184, 0.3);
}

.va-notes b {
  color: #e9edf5;
  font-weight: 650;
}

.va-cta {
  margin-top: 56px;
}

.va-article a.va-button {
  display: inline-block;
  padding: 12px 20px;
  color: #0b0f17;
  font-weight: 650;
  text-decoration: none;
  background: #f1f4f9;
  border-radius: 12px;
}

.va-article a.va-button:hover {
  background: #fff;
}

@media (max-width: 560px) {
  .va-list > div {
    grid-template-columns: 1fr;
  }
}
</style>

{{-- The head every page shares, included by layouts/default.stx.

  Everything that names the site comes from the app's own config: the title
  from APP_NAME and the canonical URL from APP_URL (via config/app.ts), so a
  deploy of an untouched app describes itself rather than anyone else.

  A page names itself by declaring `pageTitle`, `pageDescription` or
  `canonicalPath` in its own server script. A page that declares none of
  them describes the site. --}}
<script server>
import { config } from '@stacksjs/config'
import { MAP_CSS, MAP_JS } from '~/resources/assets/scripts/map-assets'
import { dataFiles } from '~/resources/functions/assets'

const appName = config.app.name || 'My App'

// APP_URL is often a bare host (`my-app.localhost`), which is not a valid
// canonical href on its own.
const rawUrl = String(config.app.url || '').replace(/\/+$/, '')
const siteUrl = rawUrl && !/^https?:\/\//.test(rawUrl) ? `https://${rawUrl}` : rawUrl

const headTitle = typeof pageTitle !== 'undefined' && pageTitle ? `${pageTitle} - ${appName}` : appName
const headDescription = typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : 'How every county in every state voted in the 2026 midterm elections, as a 3D map.'
const headPath = typeof canonicalPath !== 'undefined' && canonicalPath ? canonicalPath : '/'
const canonicalUrl = siteUrl ? `${siteUrl}${headPath}` : ''

// A page that draws the map says so with `mapPage`. Its files are then asked
// for while the page is still being read, not once its scripts have run.
const preloadMap = typeof mapPage !== 'undefined' && !!mapPage
const mapFiles = preloadMap ? dataFiles() : null
const hidden = typeof noindex !== 'undefined' && !!noindex
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b0f17">
<meta name="color-scheme" content="dark">
<title>{{ headTitle }}</title>
<meta name="description" content="{{ headDescription }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
@if(hidden)
  <meta name="robots" content="noindex">
@endif
@if(preloadMap)
  <link rel="stylesheet" href="{{ MAP_CSS }}" data-ts-maps-css="1">
  <link rel="modulepreload" href="{{ MAP_JS }}">
  <link rel="preload" as="fetch" crossorigin href="{{ mapFiles.counties }}">
  <link rel="preload" as="fetch" crossorigin href="{{ mapFiles.states }}">
  <link rel="preload" as="fetch" crossorigin href="{{ mapFiles.results }}">
@endif
@if(canonicalUrl)
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
@endif
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ appName }}">
<meta property="og:title" content="{{ headTitle }}">
<meta property="og:description" content="{{ headDescription }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ headTitle }}">
<meta name="twitter:description" content="{{ headDescription }}">
@if(siteUrl)
  <meta property="og:image" content="{{ siteUrl }}/images/share.jpg">
  <meta property="og:image:width" content="800">
  <meta property="og:image:height" content="419">
  <meta name="twitter:image" content="{{ siteUrl }}/images/share.jpg">
@endif

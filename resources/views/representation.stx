  font-weight: 650;
  font-size: 14.5px;
  text-align: right;
}

.vr-bar-note {
  color: #8693a6;
  font-size: 13px;
}

.vr-sort {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  margin: 22px 0 10px;
  color: #9aa6b8;
  font-size: 13.5px;
}

.vr-sort span {
  margin-right: 4px;
}

.vr-sort button {
  min-height: 36px;
  padding: 6px 13px;
  color: #c6cedb;
  font: inherit;
  font-weight: 550;
  background: transparent;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 999px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.vr-sort button:hover {
  border-color: rgba(148, 163, 184, 0.45);
}

.vr-sort button.is-on {
  color: #0b0f17;
  background: #e9edf5;
  border-color: #e9edf5;
}

.vr-table-wrap {
  overflow-x: auto;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 14px;
}

.vr-table {
  width: 100%;
  font-size: 14.5px;
  border-collapse: collapse;
  font-variant-numeric: tabular-nums;
}

.vr-table th,
.vr-table td {
  padding: 9px 12px;
  text-align: left;
  white-space: nowrap;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.vr-table tbody tr:last-child th,
.vr-table tbody tr:last-child td {
  border-bottom: 0;
}

.vr-table thead th {
  position: sticky;
  top: 0;
  color: #9aa6b8;

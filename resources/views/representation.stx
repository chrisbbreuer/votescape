  text-transform: uppercase;
  white-space: normal;
  vertical-align: bottom;
  background: #111827;
}

.vr-table tbody th {
  font-weight: 550;
}

.va-article .vr-table a {
  color: #e9edf5;
  text-decoration-color: rgba(148, 163, 184, 0.4);
}

.vr-table .is-num {
  text-align: right;
}

.vr-table tbody tr:hover {
  background: rgba(148, 163, 184, 0.06);
}

/* The figure, with a bar under it as long as the state's seat is large. */
.vr-per {
  position: relative;
  min-width: 130px;
}

.vr-per span {
  position: relative;
  font-weight: 650;
}

.vr-per i {
  position: absolute;
  right: 12px;
  bottom: 4px;
  height: 3px;
  max-width: calc(100% - 24px);
  background: #5b9dff;
  border-radius: 999px;
  opacity: 0.75;
}

.vr-table .is-over {
  color: #ffb4ad;
}

.vr-table .is-under {
  color: #a9c7ff;
}

.vr-table small {
  display: inline-block;
  min-width: 34px;
  margin-left: 6px;
  color: #8693a6;
  font-size: 12px;
  text-align: left;
}

.va-article p.vr-foot {
  margin-top: 12px;
  color: #8693a6;
  font-size: 13.5px;
  line-height: 1.55;
}

@media (max-width: 760px) {
  .vr-stats {
    gap: 8px;
    grid-template-columns: 1fr 1fr;
  }

  .vr-stats > div {
    padding: 14px 14px 12px;
  }

  .vr-stats > div:last-child {
    grid-column: 1 / -1;
  }

  .vr-timeline li {
    grid-template-columns: 1fr;
  }

  .vr-bar-row {
    grid-template-columns: 40px minmax(0, 1fr) 70px;
  }

  .vr-bar-note {
    display: none;
  }

  /* A phone has room for the present: the 1910 columns are for a wider screen. */
  .vr-wide {
    display: none;
  }

  .vr-table th,
  .vr-table td {
    padding: 10px 8px;
  }

  .vr-table {
    font-size: 14px;
  }

  .vr-per {
    min-width: 0;
  }

  .vr-sort button {
    min-height: 40px;
  }
}
</style>
@endsection

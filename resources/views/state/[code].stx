@extends('default')
@section('content')
<script server>
/**
 * One state on its own: `/state/tx`. The rest of the country lies flat
 * around it, and heights are set by the state's own tallest county.
 *
 * A code that names no state is not a page: it answers 404 and says so,
 * rather than showing the country under an address that means nothing.
 */
import { stateByCode } from '~/resources/data/states'
import { stateSummary } from '~/resources/functions/summary'

const asked = String(params?.code || '')
const found = stateByCode(asked)
if (!found)
  notFound()

const code = found ? found.code : ''
const missing = !found
const summary = found ? stateSummary(found.code) : null
const pageTitle = found ? `${found.name} 2026 midterm results by county, in 3D` : 'No such state'
const pageDescription = summary ? summary.description : 'There is no state at this address on Votescape.'
const pageImageAlt = summary ? `${summary.title}. ${summary.subtitle} A 3D map of its counties, as tall as their votes.` : ''
const pageCrumb = found ? found.name : ''
const canonicalPath = found ? `/state/${found.code}` : `/state/${asked}`
const noindex = missing
const mapPage = !missing
</script>
@if(missing)
  <NotFound what="That state" />
@else
  <ElectionMap :focus="code" />
@endif
@endsection

  .vs-phone-only {
    display: block;
  }

  .vs-race-links a {
    min-height: 36px;
    padding: 6px 12px;
    font-size: 13px;
  }

  /* Open, the totals are read, not looked through. */
  .vs-totals.is-open {
    background: rgba(13, 18, 28, 0.97);
  }

  /* An open panel can be longer than the room above the dock: it scrolls. */
  .vs-totals.is-open,
  .vs-dock .vs-county {
    max-height: calc(100dvh - 300px - var(--vs-t) - var(--vs-b));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* A place takes the legend's room, and gives it back when it is let go:
     the years stay, so one county can be followed from election to election. */
  .vs-stage:has(.vs-county) .vs-key {
    display: none;
  }

  .vs-key > .vs-key-row:first-child {
    display: none;
  }

  .vs-scale {
    margin-top: 0;
  }

  .vs-key-height {
    margin-top: 8px;
    padding-top: 0;
    border-top: 0;
  }

  .vs-key-height .vs-eyebrow {
    padding-left: 4px;
  }

  .vs-county .vs-count {
    display: inline;
    min-width: 0;
  }

  .vs-county .vs-sides {
    grid-template-columns: 1fr;
    gap: 4px;
  }

  .vs-hint {
    font-size: 12px;
  }

  /* What opens over the map comes up from the bottom, under the thumb. */
  .vs-states,
  .vs-table,
  .vs-share-menu {
    inset: auto 0 0;
    width: auto;
    max-width: none;
    max-height: min(84dvh, calc(100dvh - 56px - var(--vs-t)));
    padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    border-width: 1px 0 0;
    border-radius: 20px 20px 0 0;
    transform: translateY(24px);
    overscroll-behavior: contain;
  }

  .vs-states::backdrop,
  .vs-table::backdrop,
  .vs-share-menu::backdrop {
    background: rgba(5, 8, 13, 0.55);
  }

  .vs-btn {
    padding: 7px 9px;
  }

  .vs-top-end {
    gap: 2px;
  }

  .vs-states ul {
    columns: 2;
  }
}

/* --- Under a finger: everything to press is at least 40px tall --- */

@media (pointer: coarse) {
  /* Glass over a moving map is drawn again every frame, and a phone feels
     it. Panels there are nearly solid, with nothing behind them to blur. */
  .vs-stage {
    --vs-panel: rgba(14, 19, 30, 0.9);
  }

  .vs-panel,
  .vs-seg,
  .vs-btn,
  .vs-years,
  .vs-hint,
  .vs-controls {
    backdrop-filter: none;

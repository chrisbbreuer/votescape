}

/* A tablet under a finger: the taller switcher sets the totals lower. */
@media (pointer: coarse) and (min-width: 721px) and (max-width: 1040px) and (min-height: 521px) {
  .vs-totals {
    top: calc(134px + var(--vs-t));
  }
}

/* --- A phone on its side: one row across the top, small panels in the corners --- */

@media (max-height: 520px) {
  .vs-top {
    grid-template-columns: auto 1fr auto;
    row-gap: 0;
    padding-top: calc(8px + var(--vs-t));

{{-- The map and everything laid over it: which office is shown, the totals,
  the county under the pointer, the legend, and the way to each state.

  Used by the home page for the whole country and by a state's page for one
  state, which passes that state's postal code as focus. The map itself is
  drawn by resources/composables/useElectionMap.ts into the element marked
  data-stx-ignore, which stx leaves alone.

  On a wide screen the panels sit in the corners around the map. On a phone
  they stack: what is shown above the map, the place and the legend below. --}}
<script server>
import { ELECTIONS, LATEST } from '~/resources/data/elections'
import { stateByCode, STATES } from '~/resources/data/states'
import { dataFiles } from '~/resources/functions/assets'

export const files = dataFiles()
// The elections there are results for. The present one is always offered:
// where it has none yet, the page says so.
export const elections = ELECTIONS.filter(e => e === LATEST || files.years[e.year])
export const yearFiles = JSON.stringify(files.years)
export const firstYear = elections[0].year
export const lastYear = LATEST.year

export const focus = String($props.focus || '').toLowerCase()
export const focusState = stateByCode(focus)
export const focusName = focusState ? focusState.name : ''
export const stateLinks = STATES
export const heading = focusName ? `${focusName} in every election from ${firstYear} to ${lastYear}, county by county` : `Every election from ${firstYear} to ${lastYear}, county by county`
</script>

<script client>
import type { CountyInfo, ElectionInfo, ElectionMapHandle, Summary } from '../composables/useElectionMap'
import type { Election } from '../data/elections'
import type { Metric, OfficeKey } from '../functions/election'
import { ELECTIONS, LATEST } from '../data/elections'
import { mountElectionMap, readView, runWhenMapReady, writeView } from '../composables/useElectionMap'
import { reportError, startErrorReporting } from '../composables/useErrorReporting'
import { closePopover, copyText, nativeShareAvailable, saveShareCard, shareNative, shareTargets, viewUrl } from '../composables/useShare'
import { formatMargin, formatNumber } from '../functions/election'
import { officeFromLabel, raceInfo } from '../functions/races'

const election = state<Election>(LATEST)
const office = state<OfficeKey>(LATEST.offices[0])
const metric = state<Metric>('votes')
// The year whose results are on their way, while they are.
const pending = state(0)
const hovered = state<CountyInfo | null>(null)
const selected = state<CountyInfo | null>(null)
const totals = state<Summary | null>(null)
const loaded = state(false)
const failed = state(false)
const explored = state(false)
const hasResults = state(true)
const hasWebgl = state(true)
const official = state(false)
const final = state(false)
const updated = state('')
const sourceLabel = state('')
// On a small screen the totals show their first lines until they are opened.
const totalsOpen = state(false)
const copied = state(false)
const saved = state(false)
const canShare = state(false)

let handle: ElectionMapHandle | null = null
let cancel: (() => void) | null = null

/** A side's share of the two-party vote, as a percentage. */
function share(side: number, other: number): number {
  return side + other > 0 ? (side / (side + other)) * 100 : 0
}

function percent(value: number): string {
  return `${value.toFixed(1)}%`
}

const year = derived(() => election().year)
const electionLabel = derived(() => election().label)
const electionName = derived(() => election().name)
const yearShown = derived(() => pending() || year())
const hasOffice = (key: OfficeKey): boolean => election().offices.includes(key)

// The county shown in the card: the one under the pointer, else the one clicked.
const county = derived(() => hovered() ?? selected())
const countyPinned = derived(() => !!selected() && (!hovered() || hovered()?.id === selected()?.id))
const countyName = derived(() => county()?.name ?? '')
const countyState = derived(() => county()?.state ?? '')
const countyLink = derived(() => `/state/${county()?.code ?? ''}`)
const countyOffice = derived(() => (county()?.office ? `${county()?.office}, ${year()}` : ''))
const countyHasRace = derived(() => county()?.hasRace ?? false)
const countyAbsent = derived(() => (county()?.stateOnly
  ? `${county()?.state}'s ${year()} count is for the state as a whole, so there is nothing to show for this place.`
  : 'No results here for this office.'))
const countyDemName = derived(() => county()?.demName ?? '')
const countyRepName = derived(() => county()?.repName ?? '')
const countyDem = derived(() => formatNumber(county()?.dem ?? 0))
const countyRep = derived(() => formatNumber(county()?.rep ?? 0))
const countyDemShare = derived(() => share(county()?.dem ?? 0, county()?.rep ?? 0))
const countyDemPercent = derived(() => percent(countyDemShare()))
const countyRepPercent = derived(() => percent(share(county()?.rep ?? 0, county()?.dem ?? 0)))
const countyDemBar = derived(() => `width:${countyDemShare()}%`)
const countyHasSides = derived(() => (county()?.dem ?? 0) + (county()?.rep ?? 0) > 0)
const countyTotal = derived(() => `${formatNumber(county()?.total ?? 0)} votes cast`)
const countyMargin = derived(() => formatMargin(county()?.margin))
const countyLeansDem = derived(() => (county()?.margin ?? 0) > 0)
const countyCounted = derived(() => (county()?.pct === null || county()?.pct === undefined ? '' : `${county()?.pct}% of the expected vote counted`))
const countyNotes = derived(() => (county()?.notes ?? []).join(' '))

const totalsTitle = derived(() => totals()?.title ?? '')
const totalsOffice = derived(() => (totals()?.office ? `${totals()?.office}, ${year()}` : ''))
const totalsHasRace = derived(() => totals()?.hasRace ?? false)
const totalsDemName = derived(() => totals()?.demName ?? '')
const totalsRepName = derived(() => totals()?.repName ?? '')
const totalsDem = derived(() => formatNumber(totals()?.dem ?? 0))
const totalsRep = derived(() => formatNumber(totals()?.rep ?? 0))
const totalsDemShare = derived(() => share(totals()?.dem ?? 0, totals()?.rep ?? 0))
const totalsDemPercent = derived(() => percent(totalsDemShare()))
const totalsRepPercent = derived(() => percent(share(totals()?.rep ?? 0, totals()?.dem ?? 0)))
const totalsDemBar = derived(() => `width:${totalsDemShare()}%`)
const totalsVotes = derived(() => `${formatNumber(totals()?.total ?? 0)} votes cast`)
const totalsMargin = derived(() => formatMargin(totals()?.margin))
const totalsLeansDem = derived(() => (totals()?.margin ?? 0) > 0)
const totalsStatus = derived(() => totals()?.status ?? '')
const totalsNotes = derived(() => (totals()?.notes ?? []).join(' '))

// House seats, as a bar: won by each party, with what is not called between them.
const seats = derived(() => totals()?.seats ?? null)
const seatCount = derived(() => (seats()?.dem ?? 0) + (seats()?.rep ?? 0) + (seats()?.open ?? 0))
const hasSeats = derived(() => seatCount() > 0)
const seatsDem = derived(() => String(seats()?.dem ?? 0))
const seatsRep = derived(() => String(seats()?.rep ?? 0))
const seatsDemBar = derived(() => `width:${seatCount() > 0 ? ((seats()?.dem ?? 0) / seatCount()) * 100 : 0}%`)
const seatsRepBar = derived(() => `width:${seatCount() > 0 ? ((seats()?.rep ?? 0) / seatCount()) * 100 : 0}%`)
const seatsNote = derived(() => {
  const open = seats()?.open ?? 0
  const majority = Math.floor(seatCount() / 2) + 1
  const called = open > 0 ? `${open} not called. ` : ''
  return seatCount() > 1 ? `${called}${majority} of ${seatCount()} seats is a majority.` : called.trim()
})

// --- What the race was, and where to read about it. ---

const race = derived(() => {
  const sum = totals()
  const key = officeFromLabel(sum?.office ?? '')
  return sum?.hasRace && key ? raceInfo(election(), key, sum.title === 'United States' ? '' : sum.title) : null
})
const raceText = derived(() => race()?.text ?? '')
const raceIsHouse = derived(() => officeFromLabel(totals()?.office ?? '') === 'house')
const raceDate = derived(() => (race() ? `Election day: ${race()?.date}` : ''))
const raceLabel = derived(() => race()?.links[0]?.label ?? '')
const raceHref = derived(() => race()?.links[0]?.href ?? '')
const raceTitle = derived(() => race()?.links[0]?.title ?? '')
const raceLabel2 = derived(() => race()?.links[1]?.label ?? '')
const raceHref2 = derived(() => race()?.links[1]?.href ?? '')
const raceTitle2 = derived(() => race()?.links[1]?.title ?? '')

// The county's own state's race: a county has no article, its state's race does.
const countyRace = derived(() => {
  const place = county()
  const key = officeFromLabel(place?.office ?? '')
  return place?.hasRace && key && key !== 'top' ? raceInfo(election(), key, place.state).links[0] ?? null : null
})
const countyRaceHref = derived(() => countyRace()?.href ?? '')
const countyRaceTitle = derived(() => countyRace()?.title ?? '')
const countyRaceLabel = derived(() => (countyRace() ? `${county()?.state}'s race on Wikipedia` : ''))

const sourceBadge = derived(() => (official() ? 'Certified' : final() ? 'Final count' : 'Unofficial'))
const sourceLine = derived(() => (final() ? electionLabel() : updated() ? `Updated ${updated()}` : ''))
const sourceCredit = derived(() => (sourceLabel() ? `Source: ${sourceLabel()}` : ''))

// --- Sharing: the pinned county if there is one, else the totals shown. ---

const view = derived(() => ({ year: year(), office: office(), metric: metric(), county: selected()?.id ?? '' }))
const shareUrl = derived(() => viewUrl(view()))
const shareTitle = derived(() => (selected() ? `${selected()?.name}, ${selected()?.state}` : totalsTitle() === 'United States' || !totalsTitle() ? 'The United States' : totalsTitle()))
const shareText = derived(() => {
  const place = selected()
  const margin = place ? formatMargin(place.margin) : totalsMargin()
  const hasRace = place ? place.hasRace : totalsHasRace()
  const what = place ? place.office : totals()?.office ?? ''
  const lead = !hasRace || !margin
    ? `${shareTitle()} in ${electionName()}.`
    : margin === 'Even'
      ? `${shareTitle()} split evenly for ${what} in ${electionName()}.`
      : `${shareTitle()} went ${margin} for ${what} in ${electionName()}.`
  return `${lead} Every county in 3D, as tall as its votes.`
})
const shareLinks = derived(() => shareTargets(shareText(), shareUrl(), `${electionName().replace(/^the/, 'The')}, county by county`))
const shareX = derived(() => shareLinks().x)
const shareFacebook = derived(() => shareLinks().facebook)
const shareLinkedin = derived(() => shareLinks().linkedin)
const shareReddit = derived(() => shareLinks().reddit)
const shareBluesky = derived(() => shareLinks().bluesky)
const shareThreads = derived(() => shareLinks().threads)
const shareWhatsapp = derived(() => shareLinks().whatsapp)
const shareTelegram = derived(() => shareLinks().telegram)
const shareEmail = derived(() => shareLinks().email)
const copyLabel = derived(() => (copied() ? 'Link copied' : 'Copy link'))
const saveLabel = derived(() => (saved() ? 'Image saved' : 'Save image'))

async function copyLink(): Promise<void> {
  if (await copyText(shareUrl())) {
    copied.set(true)
    setTimeout(() => copied.set(false), 2000)
  }
}

async function shareSheet(): Promise<void> {
  if (await shareNative(shareTitle(), shareText(), shareUrl()))
    closePopover('vs-share')
}

async function saveImage(): Promise<void> {
  const place = selected()
  const sum = totals()
  const footer = official() ? 'Certified results' : final() ? 'Final count, as reported' : `Unofficial results${updated() ? `, updated ${updated()}` : ''}`
  const when = { election: electionLabel(), year: year() }
  const card = place
    ? { ...when, eyebrow: place.office, title: place.name, subtitle: place.state, hasRace: place.hasRace, margin: formatMargin(place.margin), leansDem: (place.margin ?? 0) > 0, demName: place.demName, repName: place.repName, dem: place.dem, rep: place.rep, total: place.total, footer }
    : { ...when, eyebrow: sum?.office ?? '', title: sum?.title ?? 'United States', subtitle: '', hasRace: sum?.hasRace ?? false, margin: formatMargin(sum?.margin), leansDem: (sum?.margin ?? 0) > 0, demName: sum?.demName ?? 'Democrats', repName: sum?.repName ?? 'Republicans', dem: sum?.dem ?? 0, rep: sum?.rep ?? 0, total: sum?.total ?? 0, footer }
  if (await saveShareCard(card, shareText(), shareUrl()) === 'saved') {
    saved.set(true)
    setTimeout(() => saved.set(false), 2000)
  }
}

function toggleTotals(): void {
  totalsOpen.set(!totalsOpen())
}

/** What the page says about the results now shown. */
function shown(info: ElectionInfo): void {
  election.set(info.election)
  office.set(info.office)
  hasResults.set(!!info.meta)
  official.set(!!info.meta?.official)
  final.set(!!info.meta?.final)
  sourceLabel.set(info.meta?.sourceLabel ?? '')
  updated.set(info.meta?.updatedAt ? new Date(info.meta.updatedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '')
}

async function chooseYear(next: number): Promise<void> {
  if (!handle || next === yearShown())
    return
  pending.set(next)
  const info = await handle.setElection(next)
  // Another year was asked for while this one was on its way: that one answers.
  if (pending() !== next)
    return
  pending.set(0)
  if (!info)
    return
  shown(info)
  totals.set(handle.summary())
  writeView(view())
}

/** A year about to be chosen: its results are asked for while the finger is still coming down. */
function warmYear(next: number): void {
  handle?.warm(next)
}

function chooseOffice(next: OfficeKey): void {
  office.set(next)
  handle?.setOffice(next)
  totals.set(handle?.summary() ?? null)
  writeView(view())
}

function chooseMetric(next: Metric): void {
  metric.set(next)
  handle?.setMetric(next)
  writeView(view())
}

function resetView(): void {
  handle?.resetView()
}

function zoomIn(): void {
  handle?.zoom(1)
}

function zoomOut(): void {
  handle?.zoom(-1)
}

function turnLeft(): void {
  handle?.turn(-30)
}

function turnRight(): void {
  handle?.turn(30)
}

function unpin(): void {
  handle?.clearSelection()
}

async function mount(): Promise<void> {
  startErrorReporting()
  canShare.set(nativeShareAvailable())
  const asked = readView()
  election.set(ELECTIONS.find(e => e.year === asked.year) ?? LATEST)
  office.set(asked.office)
  metric.set(asked.metric)
  try {
    handle = await mountElectionMap('election-map', {
      year: asked.year,
      office: asked.office,
      metric: asked.metric,
      county: asked.county,
      ids: { search: 'vs-search', places: 'vs-places', popover: 'vs-states', table: 'vs-table-body' },
      onHover: info => hovered.set(info),
      onSelect: (info) => {
        selected.set(info)
        writeView(view())
      },
      onExplore: () => explored.set(true),
      onReady: (ready) => {
        shown(ready)
        hasWebgl.set(ready.webgl)
      },
    })
  }
  catch (error) {
    // Whatever went wrong, say so: the alternative is a loader that never ends.
    console.error('[votescape] the map could not be drawn:', error)
    reportError(error, { where: 'map mount', year: asked.year, office: asked.office, metric: asked.metric })
    handle = null
  }
  // Drawn nothing without throwing: the shapes or the library did not arrive.
  if (!handle && !failed())
    reportError(new Error('The map did not mount'), { where: 'map mount', year: asked.year, office: asked.office })
  failed.set(!handle)
  totals.set(handle?.summary() ?? null)
  loaded.set(true)
}

onMount(() => {
  cancel = runWhenMapReady('election-map', mount)
})

onDestroy(() => {
  cancel?.()
  handle?.destroy()
  handle = null
})
</script>

<div class="vs-stage" :class="selected() ? 'has-pin' : ''">
  <h1 class="sr-only">{{ heading }}</h1>

  <div id="election-map" data-stx-ignore data-focus="{{ focus }}" data-counties="{{ files.counties }}" data-states="{{ files.states }}" data-results="{{ files.results }}" data-years="{{ yearFiles }}" class="vs-map" role="application" aria-label="3D map of results by county. Drag to move, pinch or use the wheel to zoom, tap or click a county for its result."></div>

  {{-- Over the map until it is drawn. --}}
  <div class="vs-veil" :class="loaded() ? 'is-done' : ''" aria-hidden="true">
    <svg class="vs-veil-mark" viewBox="0 0 48 48" width="48" height="48" fill="none">
      <rect x="6" y="22" width="9" height="20" rx="2" fill="#5b9dff" />
      <rect x="19.5" y="6" width="9" height="36" rx="2" fill="#e8dce4" />
      <rect x="33" y="15" width="9" height="27" rx="2" fill="#ff6f66" />
    </svg>
    <p>Raising 3,153 counties</p>
  </div>

  {{-- Across the top: where you are, what is shown, and where else to go. --}}
  <header class="vs-top">
    <div class="vs-top-start">
      <a class="vs-brand" href="/" aria-label="Votescape, the whole country">
        <svg viewBox="0 0 48 48" width="26" height="26" fill="none" aria-hidden="true">
          <rect x="6" y="22" width="9" height="20" rx="2" fill="#5b9dff" />
          <rect x="19.5" y="6" width="9" height="36" rx="2" fill="#e8dce4" />
          <rect x="33" y="15" width="9" height="27" rx="2" fill="#ff6f66" />
        </svg>
        <span>Votescape</span>
      </a>
      @if(focusName)
        <a class="vs-crumb" href="/" aria-label="All states">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>All states</span>
        </a>
      @else
        <span class="vs-tag">{{ electionLabel() }}</span>
      @endif
    </div>

    {{-- The offices of the election shown. One that was not part of it is not offered. --}}
    <div class="vs-offices vs-seg" role="group" aria-label="Office">
      <button type="button" :class="!hasOffice('president') ? 'is-off' : loaded() && office() === 'president' ? 'is-on' : ''" :aria-pressed="office() === 'president' ? 'true' : 'false'" @click="chooseOffice('president')">President</button>
      <button type="button" :class="!hasOffice('house') ? 'is-off' : loaded() && office() === 'house' ? 'is-on' : ''" :aria-pressed="office() === 'house' ? 'true' : 'false'" @click="chooseOffice('house')">House</button>
      <button type="button" :class="!hasOffice('senate') ? 'is-off' : loaded() && office() === 'senate' ? 'is-on' : ''" :aria-pressed="office() === 'senate' ? 'true' : 'false'" @click="chooseOffice('senate')">Senate</button>
      <button type="button" :class="!hasOffice('governor') ? 'is-off' : loaded() && office() === 'governor' ? 'is-on' : ''" :aria-pressed="office() === 'governor' ? 'true' : 'false'" @click="chooseOffice('governor')">Governor</button>
      <button type="button" :class="!hasOffice('top') ? 'is-off' : loaded() && office() === 'top' ? 'is-on' : ''" :aria-pressed="office() === 'top' ? 'true' : 'false'" @click="chooseOffice('top')">Top of ticket</button>
    </div>

    <div class="vs-top-end">
      <button type="button" class="vs-btn" popovertarget="vs-states">
        <span>Places</span>
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="vs-btn vs-btn-quiet" popovertarget="vs-table">Table</button>
      <button type="button" class="vs-btn vs-btn-quiet vs-btn-share" popovertarget="vs-share" aria-label="Share">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true"><path d="M8 10V2.5M5 5l3-3 3 3M3.5 8.5v4a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>Share</span>
      </button>
      <a class="vs-btn vs-btn-about vs-btn-quiet" href="/about">About</a>
    </div>
  </header>

  {{-- Every state, as links: a reader picks one, and a crawler finds them all. --}}
  <nav id="vs-states" popover class="vs-states" aria-label="Places">
    <label class="vs-states-title" for="vs-search">Find a county</label>
    <div class="vs-search">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" /><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      <input id="vs-search" type="search" list="vs-places" placeholder="Harris County, Texas" autocomplete="off" spellcheck="false" enterkeyhint="go">
      <datalist id="vs-places" data-stx-ignore></datalist>
    </div>
    <p class="vs-states-title">Go to a state</p>
    <ul>
      <li><a href="/" class="{{ focus ? '' : 'is-here' }}">United States</a></li>
      @foreach(stateLinks as link)
        <li><a href="/state/{{ link.code }}" class="{{ link.code === focus ? 'is-here' : '' }}">{{ link.name }}</a></li>
      @endforeach
    </ul>
    <p class="vs-states-foot"><a href="/about">About the map</a><a href="/representation">How many people a seat stands for</a><a href="/about#updates">Get updates by email</a></p>
  </nav>

  {{-- A link to this view, and the places it can be posted. --}}
  <section id="vs-share" popover class="vs-share-menu" aria-label="Share">
    <div class="vs-table-head">
      <p class="vs-states-title">Share this view</p>
      <button type="button" class="vs-close" popovertarget="vs-share" popovertargetaction="hide" aria-label="Close">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
    <blockquote class="vs-share-text">
      <p>{{ shareText() }}</p>
      <p class="vs-share-url">{{ shareUrl() }}</p>
    </blockquote>
    <div class="vs-share-main">
      <button type="button" class="vs-share-primary" :if="canShare()" @click="shareSheet()">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true"><path d="M8 10V2.5M5 5l3-3 3 3M3.5 8.5v4a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>Share</span>
      </button>
      <button type="button" :class="copied() ? 'is-done' : ''" @click="copyLink()">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true"><path d="M6.8 9.2a2.6 2.6 0 0 0 3.7 0l2.2-2.2a2.6 2.6 0 0 0-3.7-3.7l-.7.7M9.2 6.8a2.6 2.6 0 0 0-3.7 0L3.3 9a2.6 2.6 0 0 0 3.7 3.7l.7-.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        <span aria-live="polite">{{ copyLabel() }}</span>
      </button>
      <button type="button" :class="saved() ? 'is-done' : ''" @click="saveImage()">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true"><rect x="2.5" y="3" width="11" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5" /><path d="m3 11 3-3 2.5 2.5L10.5 8.5 13 11" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="6" cy="6" r="1" fill="currentColor" /></svg>
        <span aria-live="polite">{{ saveLabel() }}</span>
      </button>
    </div>
    <p class="vs-share-on vs-states-title">Post it on</p>
    <ul class="vs-share-sites">
      <li><a :href="shareX()" target="_blank" rel="noopener noreferrer">X</a></li>
      <li><a :href="shareBluesky()" target="_blank" rel="noopener noreferrer">Bluesky</a></li>
      <li><a :href="shareThreads()" target="_blank" rel="noopener noreferrer">Threads</a></li>
      <li><a :href="shareFacebook()" target="_blank" rel="noopener noreferrer">Facebook</a></li>
      <li><a :href="shareLinkedin()" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a :href="shareReddit()" target="_blank" rel="noopener noreferrer">Reddit</a></li>
      <li><a :href="shareWhatsapp()" target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
      <li><a :href="shareTelegram()" target="_blank" rel="noopener noreferrer">Telegram</a></li>
      <li><a :href="shareEmail()">Email</a></li>
    </ul>
  </section>

  {{-- The same numbers as rows, for reading and for a screen reader. --}}
  <section id="vs-table" popover class="vs-table" aria-label="Results as a table">
    <div class="vs-table-head">
      <p class="vs-states-title">Results as a table</p>
      <button type="button" class="vs-close" popovertarget="vs-table" popovertargetaction="hide" aria-label="Close">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div id="vs-table-body" data-stx-ignore class="vs-table-body"><p>Loading the results.</p></div>
  </section>

  <noscript>
    <div class="vs-noscript">
      <h2>This map needs JavaScript</h2>
      <p>Votescape draws every county in your browser, so it cannot show anything with JavaScript turned off. The <a href="/about">about page</a> explains what the map shows.</p>
    </div>
  </noscript>

  {{-- The totals for what is shown. --}}
  <section class="vs-panel vs-totals" :class="totalsOpen() ? 'is-open' : ''" :if="loaded() && hasResults()" aria-live="polite">
    <div class="vs-panel-head">
      <div>
        <p class="vs-eyebrow">{{ totalsOffice() }}</p>
        <h2>{{ totalsTitle() }}<span class="vs-badge vs-badge-phone" :class="official() ? 'is-official' : ''">{{ sourceBadge() }}</span></h2>
      </div>
      <div class="vs-panel-row vs-panel-side">
        <p class="vs-margin" :class="totalsLeansDem() ? 'is-dem' : 'is-rep'" :if="totalsHasRace() && totalsMargin()">{{ totalsMargin() }}</p>
        <button type="button" class="vs-close vs-fold" :aria-expanded="totalsOpen() ? 'true' : 'false'" aria-label="More of the totals" :if="totalsHasRace()" @click="toggleTotals()">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>

    <div :if="totalsHasRace()">
      <div class="vs-share" role="img" aria-label="Share of the two-party vote">
        <span class="vs-share-dem" :style="totalsDemBar()"></span>
      </div>
      <dl class="vs-sides">
        <div>
          <dt><i class="is-dem vs-dot"></i>{{ totalsDemName() }}</dt>
          <dd><b class="vs-pct">{{ totalsDemPercent() }}</b><span class="vs-count">{{ totalsDem() }}</span></dd>
        </div>
        <div>
          <dt><i class="is-rep vs-dot"></i>{{ totalsRepName() }}</dt>
          <dd><b class="vs-pct">{{ totalsRepPercent() }}</b><span class="vs-count">{{ totalsRep() }}</span></dd>
        </div>
      </dl>

      <div class="vs-seats" :if="hasSeats()">
        <div class="vs-seats-head">
          <span class="is-dem">{{ seatsDem() }} seats</span>
          <span class="is-rep">{{ seatsRep() }} seats</span>
        </div>
        <div class="vs-seats-bar" role="img" aria-label="House seats won by each party">
          <span class="vs-seats-dem" :style="seatsDemBar()"></span>
          <span class="vs-seats-rep" :style="seatsRepBar()"></span>
          <i></i>
        </div>
        <p class="vs-small">{{ seatsNote() }}</p>
      </div>

      <p class="vs-more vs-status" :if="!hasSeats() && totalsStatus()">{{ totalsStatus() }}</p>
      <p class="vs-more vs-small">{{ totalsVotes() }}</p>
      <p class="vs-more vs-small" :if="totalsNotes()">{{ totalsNotes() }}</p>
    </div>
    <p class="vs-status" :if="!totalsHasRace()">This office was not on the ballot here in {{ year() }}.</p>

    {{-- What was being decided, and where to read about it. --}}
    <div class="vs-more vs-race" :if="raceText()">
      <p class="vs-eyebrow">About this race</p>
      <p class="vs-small">{{ raceText() }}</p>
      <p class="vs-small">{{ raceDate() }}</p>
      <p class="vs-race-links">
        <a :href="raceHref()" :title="raceTitle()" target="_blank" rel="noopener noreferrer">{{ raceLabel() }}<svg viewBox="0 0 16 16" width="11" height="11" fill="none" aria-hidden="true"><path d="M6 3.5H3.5v9h9V10M9 3.5h3.5V7M12.5 3.5 7 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <a :if="raceHref2()" :href="raceHref2()" :title="raceTitle2()" target="_blank" rel="noopener noreferrer">{{ raceLabel2() }}<svg viewBox="0 0 16 16" width="11" height="11" fill="none" aria-hidden="true"><path d="M6 3.5H3.5v9h9V10M9 3.5h3.5V7M12.5 3.5 7 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <a :if="raceIsHouse()" href="/representation">People per seat</a>
      </p>
      <p class="vs-phone-only vs-small">{{ sourceLine() }}<span :if="sourceLine() && sourceCredit()">. </span>{{ sourceCredit() }}</p>
    </div>
  </section>

  <section class="vs-panel vs-totals" :if="loaded() && !hasResults() && !failed()">
    <h2>No results yet</h2>
    <p class="vs-status">The map is drawn, but the results have not been published here yet.</p>
  </section>

  <section class="vs-panel vs-totals" :if="failed()" role="alert">
    <h2>The map could not load</h2>
    <p class="vs-status">Check your connection and reload the page.</p>
  </section>

  {{-- Turning the map without a touch screen. --}}
  <div class="vs-controls" role="group" aria-label="Map view">
    <button type="button" aria-label="Zoom in" title="Zoom in" @click="zoomIn()">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
    <button type="button" aria-label="Zoom out" title="Zoom out" @click="zoomOut()">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
    <button type="button" aria-label="Turn left" title="Turn left" @click="turnLeft()">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.6-3.4M3 2.5v2.6h2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" aria-label="Turn right" title="Turn right" @click="turnRight()">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M12.5 8a4.5 4.5 0 1 1-1.6-3.4M13 2.5v2.6h-2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" aria-label="Reset the view" title="Reset the view" @click="resetView()">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M2.5 7.5 8 3l5.5 4.5M4 6.5V13h8V6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>

  {{-- Along the bottom: which election, the place chosen, and the legend. In
    the corners on a wide screen; one stack, in this order, on a narrow one. --}}
  <div class="vs-dock">
    <p class="vs-hint" :class="explored() ? 'is-gone' : ''" :if="loaded() && !failed() && !county()" aria-hidden="true">
      <span class="vs-hint-mouse">Drag to move. Pinch or wheel to zoom. Right-drag to orbit.</span>
      <span class="vs-hint-touch">Tap a county. Pinch to zoom, twist to turn.</span>
    </p>

    {{-- Which election: the years there are results for, oldest first. --}}
    <nav class="vs-years" aria-label="Election">
      @foreach(elections as e)
        <button type="button" data-kind="{{ e.kind }}" :class="yearShown() === {{ e.year }} ? (pending() ? 'is-on is-busy' : 'is-on') : ''" :aria-pressed="year() === {{ e.year }} ? 'true' : 'false'" aria-label="{{ e.label }}" title="{{ e.label }}" @pointerenter="warmYear({{ e.year }})" @pointerdown="warmYear({{ e.year }})" @click="chooseYear({{ e.year }})">
          <b>{{ e.year }}</b>
          <span>{{ e.kind === 'presidential' ? 'President' : 'Midterm' }}</span>
        </button>
      @endforeach
    </nav>

    {{-- The county under the pointer, or the one clicked. --}}
    <section class="vs-county vs-panel" :if="county()" aria-live="polite">
      <div class="vs-panel-head">
        <div>
          <p class="vs-eyebrow">{{ countyOffice() }}</p>
          <h2>{{ countyName() }}</h2>
          <a class="vs-link" :href="countyLink()">{{ countyState() }}</a>
        </div>
        <div class="vs-panel-side">
          <button type="button" class="vs-close" aria-label="Close" :if="countyPinned()" @click="unpin()">
            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </button>
          <p class="vs-margin" :class="countyLeansDem() ? 'is-dem' : 'is-rep'" :if="countyHasRace() && countyMargin()">{{ countyMargin() }}</p>
        </div>
      </div>

      <div :if="countyHasRace()">
        <div class="vs-share" role="img" aria-label="Share of the two-party vote" :if="countyHasSides()">
          <span class="vs-share-dem" :style="countyDemBar()"></span>
        </div>
        <dl class="vs-sides">
          <div>
            <dt><i class="is-dem vs-dot"></i>{{ countyDemName() }}</dt>
            <dd><b class="vs-pct">{{ countyDemPercent() }}</b><span class="vs-count">{{ countyDem() }}</span></dd>
          </div>
          <div>
            <dt><i class="is-rep vs-dot"></i>{{ countyRepName() }}</dt>
            <dd><b class="vs-pct">{{ countyRepPercent() }}</b><span class="vs-count">{{ countyRep() }}</span></dd>
          </div>
        </dl>
        <p class="vs-small">{{ countyTotal() }}<span :if="countyCounted()">. {{ countyCounted() }}</span></p>
        <p class="vs-small" :if="countyNotes()">{{ countyNotes() }}</p>
        <p class="vs-race-links" :if="countyRaceHref()">
          <a :href="countyRaceHref()" :title="countyRaceTitle()" target="_blank" rel="noopener noreferrer">{{ countyRaceLabel() }}<svg viewBox="0 0 16 16" width="11" height="11" fill="none" aria-hidden="true"><path d="M6 3.5H3.5v9h9V10M9 3.5h3.5V7M12.5 3.5 7 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </p>
      </div>
      <p class="vs-status" :if="!countyHasRace()">{{ countyAbsent() }}</p>
    </section>

    {{-- What the colours and heights mean, and where the numbers are from. --}}
    <aside class="vs-key vs-panel" aria-label="Legend">
      <div class="vs-key-row">
        <span class="vs-eyebrow">Colour: the margin</span>
      </div>
      <div class="vs-scale" role="img" aria-label="Colour scale from a Republican lead of 50 points or more, through even, to a Democratic lead of 50 points or more"></div>
      <div class="vs-scale-ends">
        <span>R+50</span>
        <span>Even</span>
        <span>D+50</span>
      </div>
      <ul class="vs-chips vs-more">
        <li><i class="is-grey"></i>No Democrat against a Republican</li>
        <li><i class="is-flat"></i>No race</li>
      </ul>

      <div class="vs-key-height vs-key-row">
        <span class="vs-eyebrow">Height</span>
        <div class="vs-seg vs-seg-small" role="group" aria-label="Height">
          <button type="button" :class="metric() === 'votes' ? 'is-on' : ''" :aria-pressed="metric() === 'votes' ? 'true' : 'false'" @click="chooseMetric('votes')">Votes</button>
          <button type="button" :class="metric() === 'density' ? 'is-on' : ''" :aria-pressed="metric() === 'density' ? 'true' : 'false'" @click="chooseMetric('density')">Per sq mi</button>
        </div>
        <button type="button" class="vs-reset" @click="resetView()">Reset</button>
      </div>

      <p class="vs-small vs-source" :if="loaded() && hasResults()">
        <span class="vs-badge" :class="official() ? 'is-official' : ''">{{ sourceBadge() }}</span>
        <span>{{ sourceLine() }}</span>
        <span class="vs-credit vs-more">{{ sourceCredit() }}</span>
      </p>
      <p class="vs-small vs-warn" :if="loaded() && !hasWebgl()">This browser has no WebGL, so counties are drawn flat.</p>
    </aside>
  </div>
</div>

<style>
.vs-stage {
  --vs-bg: #0b0f17;
  --vs-panel: rgba(14, 19, 30, 0.74);
  --vs-line: rgba(148, 163, 184, 0.18);
  --vs-line-strong: rgba(148, 163, 184, 0.32);
  --vs-text: #e9edf5;
  --vs-muted: #9aa5b8;
  --vs-faint: #6f7a8e;
  --vs-dem: #5b9dff;
  --vs-rep: #ff6f66;
  --vs-gap: 16px;
  /* The gap from each edge, clear of a phone's notch and home bar. */
  --vs-t: env(safe-area-inset-top, 0px);
  --vs-l: calc(var(--vs-gap) + env(safe-area-inset-left, 0px));
  --vs-r: calc(var(--vs-gap) + env(safe-area-inset-right, 0px));
  --vs-b: calc(var(--vs-gap) + env(safe-area-inset-bottom, 0px));

  position: relative;
  overflow: hidden;
  width: 100%;
  height: 100vh;
  height: 100dvh;
  color: var(--vs-text);
  background: var(--vs-bg);
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 14px;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  overscroll-behavior: none;
}

.vs-stage *,
.vs-stage *::before,
.vs-stage *::after {
  box-sizing: border-box;
}

.vs-stage p,
.vs-stage h2,
.vs-stage dl,
.vs-stage dd,
.vs-stage ul {
  margin: 0;
  padding: 0;
}

.vs-stage ul {
  list-style: none;
}

.vs-stage button {
  font: inherit;
  color: inherit;
  cursor: pointer;
  /* A tap is a tap: no wait to see whether it is the first of two. */
  touch-action: manipulation;
  -webkit-user-select: none;
  user-select: none;
}

.vs-stage :focus-visible {
  outline: 2px solid #8ab4ff;
  outline-offset: 2px;
}

.vs-map {
  position: absolute;
  inset: 0;
  touch-action: none;
}

/* --- Loading --- */

.vs-veil {
  display: flex;
  position: absolute;
  inset: 0;
  z-index: 900;
  flex-direction: column;
  gap: 14px;
  align-items: center;
  justify-content: center;
  color: var(--vs-muted);
  background: var(--vs-bg);
  transition: opacity 0.5s ease, visibility 0.5s;
}

.vs-veil.is-done {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.vs-veil-mark rect {
  transform-origin: 50% 100%;
  transform-box: fill-box;
  animation: vs-rise 1.4s ease-in-out infinite;
}

.vs-veil-mark rect:nth-child(2) {
  animation-delay: 0.15s;
}

.vs-veil-mark rect:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes vs-rise {
  0%,
  100% {
    transform: scaleY(0.45);
  }
  50% {
    transform: scaleY(1);
  }
}

/* --- Top bar --- */

.vs-top {
  display: grid;
  position: absolute;
  inset: 0 0 auto;
  z-index: 1000;
  gap: 12px;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: calc(14px + var(--vs-t)) var(--vs-r) 28px var(--vs-l);
  pointer-events: none;
  background: linear-gradient(180deg, rgba(11, 15, 23, 0.92) 0%, rgba(11, 15, 23, 0.6) 55%, rgba(11, 15, 23, 0) 100%);
}

.vs-top > * {
  pointer-events: auto;
}

.vs-top-start,
.vs-top-end {
  display: flex;
  gap: 10px;
  align-items: center;
  min-width: 0;
}

.vs-top-end {
  justify-content: flex-end;
}

.vs-brand {
  display: inline-flex;
  gap: 9px;
  align-items: center;
  color: var(--vs-text);
  font-weight: 650;
  font-size: 18px;
  letter-spacing: -0.02em;
  text-decoration: none;
}

.vs-tag,
.vs-crumb {
  display: inline-flex;
  gap: 4px;
  align-items: center;
  padding: 3px 10px;
  color: var(--vs-muted);
  font-size: 12px;
  white-space: nowrap;
  text-decoration: none;
  border: 1px solid var(--vs-line);
  border-radius: 999px;
}

.vs-crumb:hover {
  color: var(--vs-text);
  border-color: var(--vs-line-strong);
}

.vs-seg {
  display: inline-flex;
  gap: 2px;
  padding: 3px;
  background: var(--vs-panel);
  border: 1px solid var(--vs-line);
  border-radius: 12px;
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
}

.vs-seg button {
  padding: 7px 14px;
  color: var(--vs-muted);
  font-weight: 550;
  font-size: 13px;
  white-space: nowrap;
  background: transparent;
  border: 0;
  border-radius: 9px;
  transition: color 0.15s ease, background-color 0.15s ease;
}

.vs-seg button:hover {
  color: var(--vs-text);
}

.vs-seg button.is-on {
  color: #0b0f17;
  background: #f1f4f9;
}

/* An office that was not part of the election shown. */
.vs-seg button.is-off {
  display: none;
}

.vs-seg-small {
  border-radius: 9px;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.vs-seg-small button {
  padding: 4px 9px;
  font-size: 12px;
  border-radius: 6px;
}

.vs-btn {
  display: inline-flex;
  gap: 6px;
  align-items: center;
  padding: 7px 12px;
  color: var(--vs-text);
  font-weight: 550;
  font-size: 13px;
  text-decoration: none;
  background: var(--vs-panel);
  border: 1px solid var(--vs-line);
  border-radius: 10px;
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
  transition: border-color 0.15s ease;
}

.vs-btn:hover {
  border-color: var(--vs-line-strong);
}

.vs-btn-quiet {
  color: var(--vs-muted);
  background: transparent;
  border-color: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.vs-btn-quiet:hover {
  color: var(--vs-text);
  border-color: transparent;
}

/* --- The list of states --- */

.vs-states {
  position: fixed;
  inset: calc(62px + var(--vs-t)) var(--vs-r) auto auto;
  width: min(520px, calc(100vw - 2 * var(--vs-gap)));
  max-height: min(82vh, 680px);
  margin: 0;
  padding: 16px;
  overflow-y: auto;
  color: var(--vs-text);
  background: rgba(14, 19, 30, 0.96);
  border: 1px solid var(--vs-line-strong);
  border-radius: 14px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
}

.vs-states::backdrop {
  background: rgba(5, 8, 13, 0.35);
}

.vs-states-title {
  margin-bottom: 10px;
  color: var(--vs-muted);
  font-size: 12px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.vs-states ul {
  columns: 3;
  column-gap: 12px;
}

.vs-states li {
  break-inside: avoid;
}

.vs-states a {
  display: block;
  padding: 5px 8px;
  color: #c6cedb;
  font-size: 13.5px;
  text-decoration: none;
  border-radius: 7px;
}

.vs-states a:hover {
  color: #fff;
  background: rgba(148, 163, 184, 0.14);
}

.vs-states a.is-here {
  color: #0b0f17;
  background: #f1f4f9;
}

.vs-search {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 14px;
  padding: 0 10px;
  color: var(--vs-muted);
  background: rgba(148, 163, 184, 0.1);
  border: 1px solid var(--vs-line);
  border-radius: 10px;
}

.vs-search:focus-within {
  border-color: #8ab4ff;
}

.vs-search input {
  flex: 1;
  min-width: 0;
  padding: 9px 0;
  color: var(--vs-text);
  font: inherit;
  font-size: 16px;
  background: transparent;
  border: 0;
  outline: none;
}

.vs-search input::placeholder {
  color: var(--vs-faint);
}

label.vs-states-title {
  display: block;
}

/* --- Sharing --- */

.vs-states-foot {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 16px;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--vs-line);
}

.vs-share-menu {
  position: fixed;
  inset: calc(62px + var(--vs-t)) var(--vs-r) auto auto;
  width: min(400px, calc(100vw - 2 * var(--vs-gap)));
  max-height: min(82vh, 680px);
  margin: 0;
  padding: 16px;
  overflow-y: auto;
  color: var(--vs-text);
  background: rgba(14, 19, 30, 0.97);
  border: 1px solid var(--vs-line-strong);
  border-radius: 14px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
}

.vs-share-menu::backdrop {
  background: rgba(5, 8, 13, 0.35);
}

.vs-stage .vs-share-text {
  margin: 0 0 12px;
  padding: 12px 14px;
  color: #d5dbe6;
  font-size: 14px;
  line-height: 1.5;
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid var(--vs-line);
  border-radius: 12px;
}

.vs-stage .vs-share-url {
  margin-top: 6px;
  overflow: hidden;
  color: var(--vs-muted);
  font-size: 12px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.vs-share-main {
  display: grid;
  gap: 8px;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
}

.vs-share-main button {
  display: inline-flex;
  gap: 7px;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 8px 10px;
  font-weight: 550;
  font-size: 13px;
  white-space: nowrap;
  background: rgba(148, 163, 184, 0.12);
  border: 1px solid var(--vs-line);
  border-radius: 10px;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.vs-share-main button:hover {
  border-color: var(--vs-line-strong);
}

.vs-share-main button.vs-share-primary {
  color: #0b0f17;
  background: #f1f4f9;
  border-color: #f1f4f9;
}

.vs-share-main button.is-done {
  color: #86efac;
  border-color: rgba(34, 197, 94, 0.45);
}

.vs-stage .vs-share-on {
  margin-top: 16px;
}

.vs-share-sites {
  display: grid;
  gap: 6px;
  grid-template-columns: repeat(3, 1fr);
}

.vs-share-sites a {
  display: block;
  padding: 9px 8px;
  color: #d5dbe6;
  font-size: 13.5px;
  text-align: center;
  text-decoration: none;
  border: 1px solid var(--vs-line);
  border-radius: 9px;
}

.vs-share-sites a:hover {
  color: #fff;
  background: rgba(148, 163, 184, 0.14);
  border-color: var(--vs-line-strong);
}

/* What opens over the map fades in from where it will rest. */
.vs-states,
.vs-table,
.vs-share-menu {
  opacity: 0;
  transform: translateY(-6px);
  transition: opacity 0.2s ease, transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1), overlay 0.26s allow-discrete, display 0.26s allow-discrete;
}

.vs-states:popover-open,
.vs-table:popover-open,
.vs-share-menu:popover-open {
  opacity: 1;
  transform: none;
}

/* --- The table of results --- */

.vs-table {
  position: fixed;
  inset: calc(62px + var(--vs-t)) var(--vs-r) auto auto;
  width: min(560px, calc(100vw - 2 * var(--vs-gap)));
  max-height: min(82vh, 720px);
  margin: 0;
  padding: 16px;
  overflow-y: auto;
  color: var(--vs-text);
  background: rgba(14, 19, 30, 0.97);
  border: 1px solid var(--vs-line-strong);
  border-radius: 14px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
}

.vs-table::backdrop {
  background: rgba(5, 8, 13, 0.35);
}

.vs-table-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vs-table-body table {
  width: 100%;
  font-size: 13.5px;
  border-collapse: collapse;
  font-variant-numeric: tabular-nums;
}

.vs-table-body caption {
  padding-bottom: 8px;
  font-weight: 650;
  font-size: 16px;
  text-align: left;
}

.vs-table-body th,
.vs-table-body td {
  padding: 6px 8px;
  font-weight: 400;
  text-align: left;
  border-bottom: 1px solid var(--vs-line);
}

.vs-table-body thead th {
  position: sticky;
  top: -16px;
  color: var(--vs-muted);
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  background: rgb(14, 19, 30);
}

.vs-table-body .is-num {
  text-align: right;
  white-space: nowrap;
}

.vs-table-body .vs-brief {
  display: none;
}

.vs-table-body .is-dem {
  color: var(--vs-dem);
  font-weight: 650;
}

.vs-table-body .is-rep {
  color: var(--vs-rep);
  font-weight: 650;
}

.vs-table-body a,
.vs-table-body th button {
  padding: 0;
  color: var(--vs-text);
  font: inherit;
  text-align: left;
  text-decoration: underline;
  text-decoration-color: var(--vs-line-strong);
  text-underline-offset: 3px;
  background: none;
  border: 0;
}

.vs-table-body a:hover,
.vs-table-body th button:hover {
  text-decoration-color: currentColor;
}

.vs-noscript {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 950;
  width: min(420px, calc(100vw - 32px));
  padding: 20px;
  background: rgb(14, 19, 30);
  border: 1px solid var(--vs-line-strong);
  border-radius: 16px;
  transform: translate(-50%, -50%);
}

.vs-noscript p {
  margin-top: 8px;
  color: #c6cedb;
}

.vs-noscript a {
  color: #8ab4ff;
}

/* --- Panels --- */

.vs-panel {
  position: absolute;
  z-index: 1000;
  width: 304px;
  max-width: calc(100vw - 2 * var(--vs-gap));
  padding: 16px;
  background: var(--vs-panel);
  border: 1px solid var(--vs-line);
  border-radius: 16px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
}

.vs-totals {
  top: calc(76px + var(--vs-t));
  left: var(--vs-l);
}

/* A panel arrives, rather than being there all at once. */
.vs-panel,
.vs-hint {
  transition: opacity 0.2s ease, transform 0.2s ease, display 0.2s allow-discrete;
}

@starting-style {
  .vs-panel {
    opacity: 0;
    transform: translateY(6px);
  }
}

.vs-county {
  bottom: var(--vs-b);
  left: var(--vs-l);
}

.vs-key {
  right: var(--vs-r);
  bottom: var(--vs-b);
}

.vs-panel-side.vs-panel-row {
  flex-direction: row;
  align-items: center;
}

/* Opens the rest of the totals, where the screen is too small to keep them open. */
.vs-close.vs-fold {
  display: none;
}

.vs-fold svg {
  transition: transform 0.2s ease;
}

.vs-totals.is-open .vs-fold svg {
  transform: rotate(180deg);
}

.vs-panel-head {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  justify-content: space-between;
}

.vs-panel-side {
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: flex-end;
}

.vs-panel h2 {
  font-weight: 650;
  font-size: 18px;
  line-height: 1.25;
  letter-spacing: -0.01em;
}

.vs-eyebrow {
  color: var(--vs-muted);
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.vs-link {
  color: var(--vs-muted);
  font-size: 13px;
  text-decoration: underline;
  text-decoration-color: var(--vs-line-strong);
  text-underline-offset: 3px;
}

.vs-link:hover {
  color: var(--vs-text);
}

.vs-margin {
  font-weight: 700;
  font-size: 26px;
  line-height: 1.1;
  letter-spacing: -0.02em;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.vs-margin.is-dem,
.vs-seats-head .is-dem {
  color: var(--vs-dem);
}

.vs-margin.is-rep,
.vs-seats-head .is-rep {
  color: var(--vs-rep);
}

.vs-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  color: var(--vs-muted);
  background: rgba(148, 163, 184, 0.12);
  border: 0;
  border-radius: 999px;
}

.vs-close:hover {
  color: var(--vs-text);
}

/* The two-party vote: the Democratic share from the left, on the Republican. */
.vs-share {
  position: relative;
  height: 8px;
  margin-top: 14px;
  overflow: hidden;
  background: var(--vs-rep);
  border-radius: 999px;
}

.vs-share-dem {
  display: block;
  height: 100%;
  background: var(--vs-dem);
  border-right: 2px solid var(--vs-bg);
  transition: width 0.35s ease;
}

.vs-sides {
  display: grid;
  gap: 6px;
  margin-top: 12px;
}

.vs-sides > div {
  display: flex;
  gap: 12px;
  align-items: baseline;
  justify-content: space-between;
}

.vs-sides dt {
  display: flex;
  gap: 8px;
  align-items: center;
  min-width: 0;
  color: #d5dbe6;
  font-size: 13.5px;
}

.vs-sides dd {
  display: flex;
  gap: 10px;
  align-items: baseline;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.vs-pct {
  font-weight: 650;
}

.vs-count {
  min-width: 78px;
  color: var(--vs-muted);
  font-size: 12.5px;
  text-align: right;
}

.vs-dot {
  flex: none;
  width: 8px;
  height: 8px;
  border-radius: 999px;
}

.vs-dot.is-dem {
  background: var(--vs-dem);
}

.vs-dot.is-rep {
  background: var(--vs-rep);
}

.vs-seats {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid var(--vs-line);
}

.vs-seats-head {
  display: flex;
  justify-content: space-between;
  font-weight: 650;
  font-size: 13.5px;
  font-variant-numeric: tabular-nums;
}

.vs-seats-bar {
  display: flex;
  position: relative;
  justify-content: space-between;
  height: 8px;
  margin: 6px 0;
  background: rgba(148, 163, 184, 0.28);
  border-radius: 999px;
}

.vs-seats-dem,
.vs-seats-rep {
  display: block;
  height: 100%;
  transition: width 0.35s ease;
}

.vs-seats-dem {
  background: var(--vs-dem);
  border-radius: 999px 0 0 999px;
}

.vs-seats-rep {
  background: var(--vs-rep);
  border-radius: 0 999px 999px 0;
}

/* The line a majority has to cross. */
.vs-seats-bar i {
  position: absolute;
  top: -3px;
  bottom: -3px;
  left: 50%;
  width: 2px;
  margin-left: -1px;
  background: #f1f4f9;
  border-radius: 2px;
}

.vs-status {
  margin-top: 12px;
  color: #c6cedb;
  font-size: 13.5px;
}

.vs-small {
  margin-top: 8px;
  color: var(--vs-muted);
  font-size: 12px;
  line-height: 1.45;
}

.vs-warn {
  color: #fbbf24;
}

/* --- Legend --- */

.vs-key-row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.vs-key-height {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid var(--vs-line);
}

/* The same stops as MARGIN_STOPS in resources/functions/election.ts. */
.vs-scale {
  height: 10px;
  margin-top: 8px;
  background: linear-gradient(90deg, #a50f15 0%, #de2d26 25%, #fb9a8a 42%, #e8dce4 50%, #9ab8ef 58%, #3b82f6 75%, #1e40af 100%);
  border-radius: 999px;
}

.vs-scale-ends {
  display: flex;
  justify-content: space-between;
  margin-top: 5px;
  color: var(--vs-muted);
  font-size: 11.5px;
  font-variant-numeric: tabular-nums;
}

.vs-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 14px;
  margin-top: 10px;
  color: var(--vs-muted);
  font-size: 12px;
}

.vs-chips li {
  display: flex;
  gap: 6px;
  align-items: center;
}

.vs-chips i {
  width: 10px;
  height: 10px;
  border-radius: 3px;
}

.vs-chips .is-grey {
  background: #7c8597;
}

.vs-chips .is-flat {
  background: #1c2434;
  border: 1px solid var(--vs-line-strong);
}

.vs-reset {
  display: none;
  margin-left: auto;
  padding: 4px 9px;
  color: var(--vs-muted);
  font-size: 12px;
  background: transparent;
  border: 1px solid var(--vs-line);
  border-radius: 8px;
}

.vs-reset:hover {
  color: var(--vs-text);
  border-color: var(--vs-line-strong);
}

.vs-source {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 8px;
  align-items: center;
  margin-top: 12px;
}

.vs-credit {
  flex-basis: 100%;
}

.vs-badge {
  padding: 2px 8px;
  font-weight: 600;
  color: #fcd34d;
  background: rgba(251, 191, 36, 0.12);
  border-radius: 999px;
}

.vs-badge-phone,
.vs-phone-only {
  display: none;
}

/* What the race was: set apart from the count above it. */
.vs-race {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--vs-line);
}

.vs-race .vs-small:first-of-type {
  margin-top: 5px;
  color: #c6cedb;
}

.vs-race .vs-small {
  margin-top: 4px;
}

.vs-race-links {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 8px;
  margin-top: 10px;
}

.vs-race-links a {
  display: inline-flex;
  gap: 6px;
  align-items: center;
  padding: 5px 10px;
  color: var(--vs-text);
  font-weight: 550;
  font-size: 12.5px;
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid var(--vs-line);
  border-radius: 999px;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.vs-race-links a:hover {
  background: rgba(148, 163, 184, 0.16);
  border-color: var(--vs-line-strong);
}

.vs-race-links svg {
  color: var(--vs-muted);
}

.vs-badge.is-official {
  color: #86efac;
  background: rgba(34, 197, 94, 0.12);
}

/* --- Map controls --- */

.vs-controls {
  display: flex;
  position: absolute;
  top: 50%;
  right: var(--vs-r);
  z-index: 1000;
  flex-direction: column;
  overflow: hidden;
  background: var(--vs-panel);
  border: 1px solid var(--vs-line);
  border-radius: 12px;
  transform: translateY(-50%);
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
}

.vs-controls button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 34px;
  color: var(--vs-muted);
  background: transparent;
  border: 0;
  border-top: 1px solid var(--vs-line);
}

.vs-controls button:first-child {
  border-top: 0;
}

.vs-controls button:hover {
  color: var(--vs-text);
  background: rgba(148, 163, 184, 0.12);
}

.vs-hint {
  position: absolute;
  bottom: calc(68px + var(--vs-b));
  left: 50%;
  z-index: 1000;
  padding: 6px 14px;
  color: var(--vs-muted);
  font-size: 12.5px;
  white-space: nowrap;
  pointer-events: none;
  background: var(--vs-panel);
  border: 1px solid var(--vs-line);
  border-radius: 999px;
  transform: translateX(-50%);
  transition: opacity 0.4s ease;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* --- Which election --- */

/* On a wide screen what is in the dock sits where it always has, in the corners. */
.vs-dock {
  display: contents;
}

.vs-years {
  display: flex;
  position: absolute;
  bottom: var(--vs-b);
  left: 50%;
  z-index: 1000;
  gap: 2px;
  padding: 3px;
  background: var(--vs-panel);
  border: 1px solid var(--vs-line);
  border-radius: 14px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  transform: translateX(-50%);
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
}

.vs-years button {
  display: grid;
  flex: 1;
  gap: 1px;
  justify-items: center;
  min-width: 62px;
  padding: 6px 8px 5px;
  color: var(--vs-muted);
  background: transparent;
  border: 0;
  border-radius: 10px;
  transition: color 0.15s ease, background-color 0.15s ease;
}

.vs-years b {
  font-weight: 650;
  font-size: 14px;
  line-height: 1.2;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.vs-years span {
  color: var(--vs-faint);
  font-weight: 600;
  font-size: 9.5px;
  line-height: 1.2;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.vs-years button:hover {
  color: var(--vs-text);
}

.vs-years button.is-on {
  color: #0b0f17;
  background: #f1f4f9;
}

.vs-years button.is-on span {
  color: #4a5567;
}

/* Its results are on their way. */
.vs-years button.is-busy b {
  animation: vs-wait 0.9s ease-in-out infinite;
}

@keyframes vs-wait {
  50% {
    opacity: 0.35;
  }
}

.vs-hint.is-gone {
  opacity: 0;
}

.vs-hint-touch {
  display: none;
}

@media (hover: none) {
  .vs-hint-mouse {
    display: none;
  }

  .vs-hint-touch {
    display: inline;
  }

  .vs-controls {
    display: none;
  }

  .vs-reset {
    display: inline-block;
  }
}

/* --- Narrower: the office switcher takes its own row --- */

@media (max-width: 1040px) {
  .vs-top {
    grid-template-columns: 1fr auto;
    row-gap: 10px;
  }

  .vs-offices {
    display: grid;
    grid-row: 2;
    grid-column: 1 / -1;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
  }

  .vs-offices button {
    padding: 8px 4px;
  }

  .vs-totals {
    top: calc(122px + var(--vs-t));
  }
}

/* --- No room for the corners: the dock is one stack along the bottom --- */

@media (max-width: 1099px) and (min-height: 521px) {
  .vs-dock {
    display: grid;
    position: absolute;
    inset: auto var(--vs-r) var(--vs-b) var(--vs-l);
    z-index: 1000;
    gap: 8px;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    pointer-events: none;
  }

  .vs-dock > * {
    position: relative;
    inset: auto;
    min-width: 0;
    pointer-events: auto;
  }

  .vs-dock .vs-hint,
  .vs-dock .vs-years {
    grid-column: 1 / -1;
    justify-self: center;
    transform: none;
  }

  .vs-dock .vs-hint {
    pointer-events: none;
  }

  .vs-dock .vs-county {
    grid-column: 1;
    justify-self: start;
  }

  .vs-dock .vs-key {
    grid-column: 2;
    justify-self: end;
  }
}

/* --- A phone: what is shown above the map, the place and the legend below --- */

@media (max-width: 720px) {
  .vs-stage {
    --vs-gap: 12px;
  }

  .vs-top {
    padding-top: calc(10px + var(--vs-t));
    padding-bottom: 18px;
  }

  .vs-btn-about,
  .vs-btn-share span {
    display: none;
  }

  .vs-tag,
  .vs-crumb span {
    display: none;
  }

  .vs-crumb {
    padding: 5px 7px;
  }

  /* A state's page has the way back beside the mark, and no room for the name. */
  .vs-top-start:has(.vs-crumb) .vs-brand span {
    display: none;
  }

  .vs-panel {
    width: auto;
    padding: 12px 14px;
    border-radius: 14px;
  }

  /* The switcher is as tall here as under a finger, so what is below it
     starts at the same place whatever is pointing. */
  .vs-offices button {
    min-height: 44px;
  }

  .vs-totals {
    top: calc(124px + var(--vs-t));
    right: var(--vs-r);
  }

  .vs-close.vs-fold {
    display: inline-flex;
  }

  .vs-totals:not(.is-open) .vs-seats {
    display: none;
  }

  .vs-panel h2 {
    font-size: 16px;
  }

  .vs-margin {
    font-size: 22px;
  }

  .vs-share {
    margin-top: 10px;
  }

  .vs-sides {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 10px;
    margin-top: 8px;
  }

  /* A long name gives way to its share, never the other way about. */
  .vs-sides dt > i {
    flex: none;
  }

  .vs-sides dt {
    display: block;
  }

  .vs-sides dt .vs-dot {
    display: inline-block;
    margin-right: 8px;
  }

  .vs-count {
    display: none;
  }

  .vs-sides dt {
    overflow: hidden;
    font-size: 12.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .vs-seats {
    margin-top: 10px;
    padding-top: 8px;
  }

  .vs-more {
    display: none;
  }

  .vs-totals.is-open .vs-more {
    display: block;
  }

  .vs-dock {
    grid-template-columns: 1fr;
  }

  .vs-dock .vs-years,
  .vs-dock .vs-county,
  .vs-dock .vs-key {
    grid-column: 1;
    justify-self: stretch;
  }

  .vs-years button {
    min-width: 0;
    padding-right: 2px;
    padding-left: 2px;
  }

  .vs-years span {
    font-size: 8.5px;
    letter-spacing: 0.03em;
  }

  /* The legend is two rows: the scale with its ends written on it, and the
     height. Whether the count is official is said with the totals. */
  .vs-key {
    padding: 8px 10px;
  }

  .vs-scale {
    height: 24px;
    border-radius: 9px;
  }

  .vs-scale-ends {
    position: relative;
    align-items: center;
    height: 24px;
    margin-top: -24px;
    padding: 0 10px;
    color: #fff;
    font-weight: 650;
    font-size: 11.5px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .vs-scale-ends span:nth-child(2) {
    color: #2a2233;
    text-shadow: none;
  }

  .vs-key .vs-source {
    display: none;
  }

  .vs-badge-phone {
    display: inline-block;
    margin-left: 8px;
    font-size: 10.5px;
    letter-spacing: 0.02em;
    vertical-align: 2px;

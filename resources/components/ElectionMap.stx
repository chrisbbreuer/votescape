  .vs-states,
  .vs-table,
  .vs-share-menu {
    inset: calc(52px + var(--vs-t)) var(--vs-r) auto auto;
    width: min(520px, calc(100vw - var(--vs-l) - var(--vs-r)));
    max-height: calc(100dvh - 60px - var(--vs-t));
  }

  .vs-states ul {
    columns: 3;
  }
}

/* --- A short window: the legend gives up its small print to the map --- */

@media (max-height: 760px) and (min-height: 521px) and (min-width: 721px) {
  /* Little height for the totals: the race keeps its links and loses its sentence. */
  .vs-race .vs-small {
    display: none;
  }

  .vs-key .vs-more {

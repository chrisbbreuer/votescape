  .vs-totals:not(.is-open) .vs-seats,
  .vs-totals:not(.is-open) .vs-sides,
  .vs-more {
    display: none;
  }

  .vs-totals.is-open .vs-more {
    display: block;
  }

  .vs-totals.is-open {
    max-height: calc(100dvh - 68px - var(--vs-t) - var(--vs-b));
    overflow-y: auto;
  }

  .vs-key {
    left: auto;
    width: auto;
    padding: 10px 12px;

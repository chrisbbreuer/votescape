{
  "name": "votescape",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Votescape",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules && pantry install && ./buddy generate:types && ./buddy lint:fix",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "./buddy build",
    "build:maps": "bun scripts/build-maps.ts",
    "data:geo": "bun scripts/build-geo.ts",
    "data:results": "bun scripts/build-results.ts",
    "data:history": "bun scripts/build-results.ts --history",
    "data": "bun run data:geo && bun run data:results && bun run data:history",
    "prod": "./buddy build",
    "check:release": "bun scripts/check-release.ts",
    "smoke": "bun scripts/smoke.ts",
    "data:cards": "bun scripts/build-cards.ts",
    "deploy": "bun scripts/build-results.ts --refresh && bun scripts/check-release.ts && ./buddy deploy --prod --yes && bun scripts/smoke.ts",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:calendar": "./buddy release --bump calendar",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "bun run typecheck:app",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:views": "bun x --bun stx typecheck --lib storage/framework/types/request-context.d.ts --lib storage/framework/types/browser-composables.d.ts 'resources/**/*.stx'",
    "typecheck:clean": "bunx --bun rimraf storage/framework/.cache/typescript",
    "types:check": "bun run typecheck",
    "types:fix": "./buddy types:fix",
    "test": "./buddy test",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "bud": "./buddy",
    "probe:integrations": "./buddy integrations:probe"
  },
  "dependencies": {
    "@bughq/sdk": "^0.3.0",
    "@stacksjs/actions": "^0.75.615",
    "@stacksjs/env": "^0.75.615",
    "@stacksjs/path": "^0.75.615",
    "@stacksjs/stx": "0.2.864",
    "stacks": "^0.75.615",
    "ts-maps": "^0.5.10"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit \"$1\""
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@stacksjs/components": "0.2.864",
    "@stacksjs/ts-cloud": "^0.16.139",
    "@types/d3-geo": "^3.1.1",
    "better-dx": "^0.2.37",
    "bun-plugin-stx": "0.2.864",
    "d3-geo": "^3.1.2",
    "mapshaper": "^0.7.101"
  },
  "overrides": {
    "@stacksjs/ts-cloud": "^0.16.139",
    "ts-images": "https://registry.pantry.dev/ts-images@22073a9",
    "@stacksjs/ts-svg": "https://registry.pantry.dev/@stacksjs/ts-svg@367a010"
  }
}
